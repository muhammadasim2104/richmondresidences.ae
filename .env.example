# Richmond Residences — server env (never expose to the browser)
# Copy shared keys from al-ghadeer-parks / the-upsides Vercel, or run:
#   ./scripts/sync-vercel-env.sh al-ghadeer-parks

# Same inbox the theupsides.ae dashboard uses for lead notify.
CONTACT_INBOX=muhammadasim124@gmail.com
LEAD_FORWARD_EMAIL=muhammadasim124@gmail.com

# Resend (agency notify only — never send auto-replies to form visitors).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Richmond Residences <onboarding@resend.dev>"

# Same Supabase project as https://theupsides.ae/dashboard
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Same env names as Valia / Al Ghadeer Parks / The Upsides.
UPSIDES_INGEST_URL=https://theupsides.ae/api/ingest
UPSIDES_INGEST_KEY=
ENABLE_LEAD_INGEST_FORWARD=

# Cloudflare Turnstile — add richmondresidences.ae hostnames to the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public WhatsApp number (same as theupsides.ae).
CONTACT_WHATSAPP_E164=971527891955

# Bot protection
BLOCK_COUNTRIES=
CHALLENGE_COUNTRIES=US

# Copy from al-ghadeer-parks Vercel (or run sync-vercel-env.sh):
#   RESEND_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY, UPSIDES_INGEST_KEY
#   TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY (add richmondresidences.ae hostnames)
# Leads write to Supabase with project_slug "richmond-residences".
